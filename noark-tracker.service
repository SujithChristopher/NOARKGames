[Unit]
Description=NOARK tracker (BLE)
After=network.target bluetooth.target

[Service]
Type=simple
User=radxa
WorkingDirectory=/home/radxa/Documents/NOARKGames
ExecStart=/home/radxa/.local/bin/uv run pyscripts/tracker.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=noark-tracker

[Install]
WantedBy=multi-user.target
